{
  "name": "workbuddy-openai-api",
  "version": "2.1.1",
  "description": "Zero-dependency local adapter from WorkBuddy Chat Completions to OpenAI Responses",
  "main": "oa-gateway.js",
  "bin": {
    "oa-gateway": "oa-gateway.js"
  },
  "scripts": {
    "start": "node oa-gateway.js",
    "test": "node oa-gateway.test.js",
    "check": "node oa-gateway.js --check-config",
    "probe": "node oa-gateway.js --probe-summary"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "openai",
    "responses-api",
    "chat-completions",
